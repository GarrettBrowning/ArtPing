# Copy this file to .env and fill in real values. Never commit .env.
# On a host (Render, Railway, etc.), set these in its environment settings instead.

# Required. A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Defaults to a local MongoDB (mongodb://localhost:27017/ArtPing).
# In production, use your hosted database's connection string (e.g. MongoDB Atlas).
MONGODB_URI=

# Optional. Defaults to 3000. Most hosts set this for you.
PORT=

# Set to "production" when deployed. Turns on HTTPS-only login cookies.
NODE_ENV=
